# Copier ce fichier en "backend/.env" puis adapter les valeurs.
# Spring Boot le lit automatiquement (spring.config.import dans application.properties).
# Format CLE=valeur, SANS guillemets ni espaces autour du "=".
# Ne jamais commiter le fichier .env (il est dans .gitignore).

# ─── PostgreSQL ─── (créer la base avant : createdb mazlove_db)
DATABASE_URL=jdbc:postgresql://localhost:5432/mazlove_db
DB_USERNAME=postgres
DB_PASSWORD=

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─── au moins 32 caractères ; générer avec : openssl rand -base64 48
JWT_SECRET=
# Durée de validité du jeton en millisecondes (7 jours)
JWT_EXPIRATION=604800000

# ─── Origines autorisées (CORS + WebSocket), séparées par des virgules ───
ALLOWED_ORIGINS=http://localhost:3000

# ─── Développement uniquement ───
# true par défaut. false n'est accepté qu'avec SPRING_PROFILES_ACTIVE=dev.
AUTH_2FA_ENABLED=true
# Affiche aussi le code de connexion dans les logs locaux ; l'envoi SMTP reste requis.
MFA_DEV_LOG_OTP=true
# Code fixe 123456, uniquement avec le profil dev et lorsque la 2FA est active.
MAZLOVE_DEV_FIXED_OTP=false
# Ajoute des comptes et praticiens fictifs (cf. application-demo.properties). Retirer en production.
SPRING_PROFILES_ACTIVE=demo

# ─── SMTP ─── 587 = STARTTLS ; 465 = TLS direct (SSL)
MAIL_HOST=smtp.example.test
MAIL_PORT=587
MAIL_USERNAME=utilisateur-fictif
MAIL_PASSWORD=mot-de-passe-fictif
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false
MAIL_FROM=no-reply@example.test

# ─── OIDC / SSO optionnel ─── actif seulement si les 3 valeurs sont définies
PUBLIC_BASE_URL=http://localhost:3000
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
