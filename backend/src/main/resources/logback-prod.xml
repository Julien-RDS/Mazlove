<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Appender pour les logs de console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender pour les logs de fichier -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-logs}/mazlove-prod.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Archive journalière -->
            <fileNamePattern>${LOG_PATH:-logs}/mazlove-prod.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- Garde 30 jours d'archives -->
            <maxHistory>30</maxHistory>
            <!-- Taille maximale par fichier -->
            <maxFileSize>100MB</maxFileSize>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender pour les logs d'erreurs -->
    <appender name="ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-logs}/mazlove-prod-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-logs}/mazlove-prod-error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <!-- Configuration des niveaux de log -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Configuration spécifique -->
    <logger name="com.mazlove" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Logs d'erreurs uniquement -->
    <logger name="org.springframework" level="ERROR" additivity="false">
        <appender-ref ref="ERROR"/>
    </logger>
    <logger name="org.hibernate" level="ERROR" additivity="false">
        <appender-ref ref="ERROR"/>
    </logger>
    <logger name="org.apache" level="ERROR" additivity="false">
        <appender-ref ref="ERROR"/>
    </logger>

    <!-- Logs de sécurité -->
    <logger name="org.springframework.security" level="INFO" additivity="false">
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Logs de performance -->
    <logger name="com.mazlove.performance" level="INFO" additivity="false">
        <appender-ref ref="FILE"/>
    </logger>

</configuration>
