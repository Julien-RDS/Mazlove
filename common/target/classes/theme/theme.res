theme.primaryColor=#FF5678
theme.secondaryColor=#FFE4EB
theme.accentColor=#8C6FC5

# Fonts
font.medium=Inter-Regular:16:plain
font.large=Inter-Bold:20:plain

# Images
theme.logo=mazlove_logo.svg
theme.providerPlaceholder=provider_placeholder.png
theme.servicePlaceholder=service_placeholder.png

# UI Components
button.primary.background=theme.primaryColor
button.primary.foreground=white
button.primary.borderRadius=8
button.primary.padding=12

button.secondary.background=theme.secondaryColor
button.secondary.foreground=theme.primaryColor
button.secondary.borderRadius=8
button.secondary.padding=12

input.background=white
input.foreground=black
input.borderRadius=8
input.padding=12

listItem.background=white
listItem.foreground=black
listItem.padding=16

toast.background=theme.secondaryColor
toast.foreground=theme.primaryColor
toast.borderRadius=8
toast.padding=12

# Colors
color.success=#4CAF50
color.error=#F44336
color.warning=#FFC107
color.info=#2196F3

color.textPrimary=black
color.textSecondary=#666666
color.textPlaceholder=#999999

color.border=#E0E0E0
color.background=#FFFFFF
color.surface=#F5F5F5

color.shadow=#000000

# Spacing
spacing.small=4
spacing.medium=8
spacing.large=16
spacing.xlarge=24

# Animations
animation.duration=300
animation.easing=cubic-bezier(0.4, 0, 0.2, 1)

# Icons
icon.size=24
icon.color=theme.primaryColor

# Scroll
scrollbar.width=8
scrollbar.color=theme.primaryColor
scrollbar.background=theme.secondaryColor
