meta {
  name: Verify OTP
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/verify-otp
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "code": "{{otp}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body.token) bru.setEnvVar("token", res.body.token);
}
