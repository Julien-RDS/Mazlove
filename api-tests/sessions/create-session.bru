meta {
  name: Create session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/sessions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "meetingPoint": {"lat":48.8584,"lng":2.347,"label":"Châtelet"},
    "providerId": "{{providerId}}",
    "startTime": "{{startTime}}",
    "duration": 1,
    "notes": ""
  }
}
